# Generated Ignition configs (rendered from Butane at build time)
config/ignition/*.ign
images/

# Top-level editable deploy config (real file; the *.example template is tracked)
/deploy*.env

# Local secrets — SSH keys, deploy keys (never commit)
secrets/

# SSH keys
*.pem
*.key
id_rsa*
id_ed25519*

# Environment files with secrets
.env
.env.*

# Admin UI build artifacts (ui/dist is rendered into the Ignition config)
ui/node_modules/
ui/dist/
ui/.astro/

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
.claude/
