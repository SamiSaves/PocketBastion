---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Logs">
  <h2>Orca — recent log lines</h2>
  <pre class="card" id="log">…</pre>
  <p class="error" id="err"></p>
</Layout>

<style>
  pre {
    margin: 0;
    padding: 0.9rem;
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>

<script>
  const log = document.getElementById('log')!;
  const err = document.getElementById('err')!;

  try {
    const res = await fetch('/api/logs');
    if (res.status === 401) location.assign('/login.html');
    else if (!res.ok) throw new Error(`HTTP ${res.status}`);
    else log.textContent = (await res.text()) || 'No log lines.';
  } catch (e) {
    err.textContent = `Could not load logs (${e instanceof Error ? e.message : e}). Reload to retry.`;
  }
</script>
