---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Password">
  <h2>Change admin password</h2>
  <form class="card" id="pw" style="padding:1rem">
    <label for="current">Current password</label>
    <input
      id="current"
      type="password"
      autocomplete="current-password"
      required
      style="margin:0.5rem 0 0.9rem"
    />
    <label for="next">New password</label>
    <input
      id="next"
      type="password"
      autocomplete="new-password"
      required
      minlength="8"
      style="margin:0.5rem 0 0.9rem"
    />
    <!-- Typed twice on purpose: a typo here locks the phone out until the SSH
         recovery path (docs/admin-ui.md), which is exactly the terminal trip
         this UI exists to avoid. -->
    <label for="again">New password, again</label>
    <input
      id="again"
      type="password"
      autocomplete="new-password"
      required
      style="margin:0.5rem 0 0.9rem"
    />
    <button type="submit" class="primary">Change password</button>
    <p class="error" id="err"></p>
  </form>
  <p>Changing the password logs every session out, this one included.</p>
</Layout>

<script>
  const form = document.getElementById('pw') as HTMLFormElement;
  const button = form.querySelector('button')!;
  const err = document.getElementById('err')!;
  const field = (id: string) => (document.getElementById(id) as HTMLInputElement).value;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    err.textContent = '';

    if (field('next') !== field('again')) {
      err.textContent = 'The new passwords do not match.';
      return;
    }

    button.disabled = true;
    try {
      const res = await fetch('/api/password', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ current: field('current'), next: field('next') }),
      });
      // Success also answers with every session invalidated, so land on the
      // login page either way.
      if (res.ok) return location.assign('/login.html');
      if (res.status === 401) return location.assign('/login.html');
      err.textContent = (await res.json()).error ?? `HTTP ${res.status}`;
    } catch (e) {
      err.textContent = `Could not reach the box (${e instanceof Error ? e.message : e}).`;
    } finally {
      button.disabled = false;
    }
  });
</script>
