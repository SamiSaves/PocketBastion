# deploy.env.example — copy to deploy.env (gitignored) and edit.
# Public keys only, no secrets. Baked into the Ignition config at render time.

# ── SSH access ────────────────────────────────────────────────────────────────
SSH_AUTHORIZED_KEY="REPLACE_ME ssh-ed25519 AAAA... you@host"

# ── Who can reach the box ─────────────────────────────────────────────────────
# The box runs no VPN of its own: put it on a LAN you reach over your own VPN,
# and never port-forward to it. Services bind to 0.0.0.0 and nftables restricts
# the source address to these space-separated CIDRs, so this is the entire
# access-control boundary in front of an AI agent with a shell. Required;
# 0.0.0.0/0 and 0/0 are rejected. The UI is plaintext HTTP, so set a server
# password on the box too.
# IPv4 only — an IPv6 CIDR makes nft reject the ruleset and the box locks down.
#   TRUSTED_CIDRS="192.168.1.0/24"      # the Pi: your LAN
#   TRUSTED_CIDRS="192.168.122.0/24"    # the mock VM: libvirt's network, NOT your LAN
#
# One file, one box. For a second box (say the mock VM), copy this to
# deploy.vm.env and render with DEPLOY_ENV=deploy.vm.env make ignition.
TRUSTED_CIDRS=

# Where the `make` management targets connect, read here by the Makefile and
# overridable per command. Required. An IP or a DNS name.
#   SERVER_HOST=pocketbastion-rpi.lan
SERVER_HOST=

# ── Git commit identity ───────────────────────────────────────────────────────
# Required before the server can commit; git refuses without name + email.
GIT_USER_NAME=
GIT_USER_EMAIL=

# ── Dev-server ports ──────────────────────────────────────────────────────────
# Space-separated ports/ranges to publish, on top of the OpenCode UI (4096).
# These are exactly the ports opened to TRUSTED_CIDRS.
#   OPENCODE_EXTRA_PORTS="3000 5173 8000-8010"
OPENCODE_EXTRA_PORTS=

# ── Memory guardrails ─────────────────────────────────────────────────────────
# All optional; leave empty on larger hosts. Defaults are tuned for a 4 GB box.
OPENCODE_MEMORY_MAX=2g
OPENCODE_MEMORY_SWAP=3g          # > MEMORY_MAX to allow swap headroom

# The box's only swap: compressed, in RAM, no disk wear. Empty means no swap at
# all — FCOS enables none by default. MiB, or an expression like "min(ram, 4096)".
# This file is sourced by bash, so quote an expression form.
#   ZRAM_SIZE=2048
#   ZRAM_SIZE="min(ram, 4096)"
ZRAM_SIZE=1024
