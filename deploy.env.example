# deploy.env.example — copy to deploy.env (gitignored) and edit.
# Public keys only, no secrets. Baked into the Ignition config at render time.
# See the README for how to generate these keys.

# ── SSH access ────────────────────────────────────────────────────────────────
# Your SSH PUBLIC key — lets you log in over the tunnel.
SSH_AUTHORIZED_KEY="REPLACE_ME ssh-ed25519 AAAA... you@host"

# ── Network mode ──────────────────────────────────────────────────────────────
# wireguard  The box runs its own VPN. Only the UDP handshake port is exposed;
#            everything else binds to the tunnel (10.44.0.1). The default, and
#            the right answer for anything on the public internet.
# lan        The network already has a VPN, so this box runs none. Services bind
#            to 0.0.0.0 and nftables restricts the source address to
#            TRUSTED_CIDRS. Requires TRUSTED_CIDRS, and OpenCode refuses to
#            start until OPENCODE_SERVER_PASSWORD is set on the server — the UI
#            is plaintext HTTP in this mode.
#
# One file, one mode. For a second box in a different mode, copy this to
# deploy.lan.env and render with DEPLOY_ENV=deploy.lan.env make ignition-local.
NETWORK_MODE=wireguard

# Space-separated CIDRs allowed to reach SSH and the published OpenCode ports.
# Required in lan mode, ignored otherwise. This is the entire access-control
# boundary in front of an AI agent with a shell; 0.0.0.0/0 is rejected.
#   TRUSTED_CIDRS="192.168.1.0/24"
TRUSTED_CIDRS=

# Where the `make` management targets connect. Defaults to 10.44.0.1 in
# wireguard mode; required in lan mode. An IP or a DNS name.
#   SERVER_HOST=pocketbastion.lan
SERVER_HOST=

# ── WireGuard bootstrap peer ──────────────────────────────────────────────────
# wireguard mode only. Your device's PUBLIC key, seeding peer #0 so the tunnel
# is up on first boot, before SSH exists.
WG_BOOTSTRAP_PUBKEY=REPLACE_ME

# This device's VPN address — any unique address in 10.44.0.0/24 (server is .1).
WG_BOOTSTRAP_IP=10.44.0.2

# ── Git commit identity ─────────────────────────────────────────────
# Required before the VM can commit (git refuses without name + email).
GIT_USER_NAME=
GIT_USER_EMAIL=

# ── Dev-server ports ──────────────────────────────────────────────────────────
# Space-separated ports/ranges to publish, on top of the OpenCode UI (4096).
# In lan mode these are exactly the ports opened to TRUSTED_CIDRS.
#   OPENCODE_EXTRA_PORTS="3000 5173 8000-8010"
OPENCODE_EXTRA_PORTS=

# ── Memory guardrails ─────────────────────────────────────────────────────────
# All optional; leave empty on larger hosts. Tuned examples are for a 2 GB box.
# Cap the (untrusted) OpenCode container so a runaway dev server is OOM-killed
# inside it instead of freezing the host — sshd + WireGuard stay alive and it
# auto-restarts. MEMORY_SWAP > MEMORY_MAX allows some (zram) swap headroom.
#   OPENCODE_MEMORY_MAX=1400m
#   OPENCODE_MEMORY_SWAP=1900m
OPENCODE_MEMORY_MAX=
OPENCODE_MEMORY_SWAP=
# Compressed RAM swap (no disk wear). A number is MiB; e.g. 2048 or an
# expression like "min(ram, 4096)".
#   ZRAM_SIZE=2048
ZRAM_SIZE=
# On-disk swapfile on the droplet's local SSD (/var/swapfile), as a backstop.
#   SWAPFILE_SIZE=2g
SWAPFILE_SIZE=
