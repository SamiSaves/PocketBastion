variant: fcos
version: 1.5.0
# pocketbastion.bu — the whole box. Targets a Raspberry Pi 4 on a microSD, and
# the local KVM mock that rehearses it (scripts/local/create-vm.sh) boots this
# very config, unmodified — that is the point of the mock.
#
# render-ignition.sh substitutes ${VARS} from deploy.env and pipes it to Butane.
passwd:
  users:
    # The core user (UID 1000) owns the rootless Quadlet containers; SSH key
    # injected at render time.
    #
    # No password_hash on purpose: the account has no password login at all, so
    # an HDMI keyboard or a serial adapter gets no shell. Recovery is a reflash.
    - name: core
      ssh_authorized_keys:
        - "${SSH_AUTHORIZED_KEY}"
      groups:
        - wheel
        - sudo
storage:
  disks:
    # coreos-boot-disk is FCOS's own symlink for "the disk I booted from",
    # created in the initramfs before Ignition runs. Using it means this config
    # does not care whether it lands on mmcblk0, sda, or a virtio disk in the
    # mock VM.
    - device: /dev/disk/by-id/coreos-boot-disk
      wipe_table: false
      partitions:
        # IMMUTABLE after the first flash: on a reflash --save-partlabel pins
        # `state` at its original offset while Ignition re-grows root to the
        # same end sector. Change this and the resize collides with your data.
        - number: 4
          label: root
          size_mib: 16384
          resize: true
        # size_mib is deliberately omitted, NOT set to 0. Omitted makes Ignition
        # adopt the existing partition; 0 makes it recompute the size against
        # current disk geometry, which differs across a reflash and hard-fails
        # in the initramfs. docs/raspberry-pi.md#the-state-partition-omits-size_mib
        - number: 5
          label: state
  filesystems:
    - device: /dev/disk/by-partlabel/state
      format: ext4
      label: state
      wipe_filesystem: false
      # noatime: this is a microSD card, every avoidable write counts.
      mount_options:
        - noatime
      with_mount_unit: true
      path: /var/mnt/state
  directories:
    # /mnt is a symlink to /var/mnt on CoreOS; use the canonical path.
    - path: /var/mnt/state
      mode: 0755
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: pocketbastion-rpi
    - path: /etc/motd
      mode: 0644
      overwrite: true
      contents:
        inline: |
          PocketBastion — reachable from ${TRUSTED_CIDRS}

          /mnt/state is the only persistent data.
          The OS is disposable: reflash to reset it.
    - path: /etc/ssh/sshd_config.d/99-hardening.conf
      mode: 0600
      contents:
        inline: |
          PasswordAuthentication no
          PermitRootLogin no
          AuthenticationMethods publickey
    # Equivalent to `loginctl enable-linger core`: starts the core user's
    # systemd instance (and its rootless containers) at boot, no login needed.
    - path: /var/lib/systemd/linger/core
      mode: 0644
      contents:
        inline: ""
    - path: /etc/containers/systemd/users/1000/opencode.container
      mode: 0644
      contents:
        local: files/etc/containers/systemd/users/1000/opencode.container
    # Butane reads `contents.local` files verbatim, so they never pass through
    # envsubst. Anything rendered has to be an `inline` dropin like this one.
    - path: /etc/containers/systemd/users/1000/opencode.container.d/10-render.conf
      mode: 0644
      contents:
        inline: |
          [Container]${OPENCODE_PUBLISH}${OPENCODE_MEMORY_ARGS}
    # Read at boot by firewall-setup.sh, so the box firewalls itself with the
    # networks it was actually rendered for.
    - path: /etc/pocketbastion/firewall.env
      mode: 0644
      contents:
        inline: |
          TRUSTED_CIDRS="${TRUSTED_CIDRS}"
          OPENCODE_PORTS="${OPENCODE_PORTS}"
          ADMIN_PORT="${ADMIN_PORT}"
    # The INITIAL admin UI password (docs/admin-ui.md). Seeded to
    # /mnt/state/admin on first start and never read again unless that copy is
    # deleted, so changing the password in the UI survives a reflash and this
    # value does not come back. 0644 is fine: it is a scrypt hash, and anything
    # that can read /etc on this box is already root or core.
    - path: /etc/pocketbastion/admin.hash
      mode: 0644
      contents:
        inline: |
          ${ADMIN_PASSWORD_HASH}
    # FCOS ships no zram config of its own, so this file is the only thing that
    # turns swap on at all. Empty ZRAM_SIZE renders it empty: no swap, and the
    # kernel OOM-kills instead. There is deliberately no on-disk swap — /var is
    # the microSD.
    - path: /etc/systemd/zram-generator.conf
      mode: 0644
      contents:
        inline: |
          ${ZRAM_CONFIG}
    # Quadlet .build unit + its Containerfile: builds a Debian/glibc OpenCode
    # image on the box (the official image is Alpine/musl, which breaks the
    # terminal). opencode.container references this via Image=opencode.build.
    - path: /etc/containers/systemd/users/1000/opencode.build
      mode: 0644
      contents:
        local: files/etc/containers/systemd/users/1000/opencode.build
    - path: /etc/pocketbastion/Containerfile
      mode: 0644
      contents:
        local: files/etc/pocketbastion/Containerfile
    - path: /usr/local/sbin/firewall-setup.sh
      mode: 0750
      contents:
        local: files/usr/local/sbin/firewall-setup.sh
    # Regenerates git/ssh config from the deploy keys on the state disk (run at
    # boot and by repo-add/repo-remove). Source of truth is the keys, not this.
    - path: /usr/local/sbin/git-setup.sh
      mode: 0750
      contents:
        local: files/usr/local/sbin/git-setup.sh
    # The entire root API available to the admin UI, behind pb-priv.socket.
    # Adding a verb to it is a security review; see docs/admin-ui.md.
    - path: /usr/local/sbin/pb-priv.sh
      mode: 0750
      contents:
        local: files/usr/local/sbin/pb-priv.sh
    # Commit identity for git inside the container, baked from deploy.env at
    # render time. git-setup.sh installs it as the container's ~/.gitconfig.
    # core.sshCommand forces our ssh config: ssh looks in the passwd home (/root),
    # not $HOME (/data), so /data/.ssh/config would otherwise be ignored.
    - path: /etc/pocketbastion/gitconfig
      mode: 0644
      contents:
        inline: |
          [user]
          name = ${GIT_USER_NAME}
          email = ${GIT_USER_EMAIL}
          [core]
          sshCommand = ssh -F /data/.ssh/config
systemd:
  units:
    - name: state-dirs.service
      enabled: true
      contents_local: files/systemd/base/state-dirs.service
    - name: git-setup.service
      enabled: true
      contents_local: files/systemd/base/git-setup.service
    - name: firewall.service
      enabled: true
      contents_local: files/systemd/base/firewall.service
    # Socket-activated, so no privileged process is running between requests.
    # Only the socket is enabled; the template is started per connection.
    - name: pb-priv.socket
      enabled: true
      contents_local: files/systemd/base/pb-priv.socket
    - name: pb-priv@.service
      contents_local: files/systemd/base/pb-priv@.service
