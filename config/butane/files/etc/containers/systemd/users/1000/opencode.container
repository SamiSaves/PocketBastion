[Unit]
Description=OpenCode headless server
# User-scope Quadlet: there is no network-online.target in a user manager.
After=podman-user-wait-network-online.service
Wants=podman-user-wait-network-online.service

[Container]
Image=opencode.build
ContainerName=opencode
# PublishPort lines are rendered into the 10-render.conf dropin: the port list
# comes from deploy.env and this file never sees envsubst.
Volume=/mnt/state/opencode:/data:Z
Environment=XDG_DATA_HOME=/data
Environment=XDG_CONFIG_HOME=/data/config
Environment=HOME=/data
Environment=POCKETBASTION=1
Volume=/mnt/state/repos:/repos:Z
WorkingDir=/repos
EnvironmentFile=/mnt/state/secrets/opencode.env
Exec=serve --hostname 0.0.0.0 --port 4096

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
