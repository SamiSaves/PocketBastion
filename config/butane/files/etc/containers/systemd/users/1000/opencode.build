# Referenced by opencode.container as `Image=opencode.build`, so systemd builds
# the image before the container starts.
[Unit]
Description=Build the OpenCode container image
# User-scope Quadlet: there is no network-online.target in a user manager, so
# naming it here was a silent no-op and the build could start before DHCP.
After=podman-user-wait-network-online.service
Wants=podman-user-wait-network-online.service

[Build]
ImageTag=localhost/opencode:latest
File=/etc/pocketbastion/Containerfile
SetWorkingDirectory=/etc/pocketbastion
