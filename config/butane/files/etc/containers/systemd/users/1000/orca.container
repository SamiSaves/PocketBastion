[Unit]
Description=Orca headless server

[Container]
Image=orca.build
ContainerName=orca
# PublishPort lines are rendered into the 10-render.conf dropin: the port list
# comes from deploy.env and this file never sees envsubst.
Volume=/mnt/state/orca:/data:Z
Environment=XDG_DATA_HOME=/data
Environment=XDG_CONFIG_HOME=/data/config
Environment=HOME=/data
Environment=POCKETBASTION=1
# Rootless podman cannot use Chromium's setuid sandbox. Orca reads this itself.
Environment=ORCA_APPIMAGE_NO_SANDBOX=1
# Agent CLIs refuse to skip permission prompts at getuid() == 0. Under rootless
# podman that uid is host 1000 (core), not host root, and the sandbox the guard
# is asking for is the container it is already in.
Environment=IS_SANDBOX=1
Volume=/mnt/state/repos:/repos:Z
WorkingDir=/repos
# Provider API keys, if any.
EnvironmentFile=/mnt/state/secrets/orca.env
# PAIRING_ADDRESS, from pairing-address.service.
EnvironmentFile=/run/pocketbastion/pairing.env
# `--no-pairing` in a dropin stops the box minting pairing offers once your
# devices are enrolled. Not the default: an unpaired box would then need an SSH
# session before it could be reached at all.
Exec=serve --port 6768

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
