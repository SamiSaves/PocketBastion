# Orca is Electron, so it needs glibc; pbweb.container borrows this same image
# purely for its node. Changing the base takes the admin UI with it.
FROM docker.io/library/node:24-slim

# Extracted, not run: a rootless container has no FUSE to mount an AppImage.
# Pinned because /releases/latest/ has resolved to tags carrying no Linux asset,
# and because a box that changes Orca version on every reflash is not one to
# want. Bump it deliberately.
ARG ORCA_VERSION=1.4.178

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      git openssh-client ca-certificates curl \
      xvfb \
      libgtk-3-0 libnss3 libasound2 libcups2 libgbm1 libatk-bridge2.0-0 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxrandr2 libxfixes3 \
      libpango-1.0-0 libcairo2 libatspi2.0-0 libdrm2; \
    case "$(uname -m)" in \
      aarch64) appimage=orca-linux-arm64.AppImage ;; \
      x86_64)  appimage=orca-linux.AppImage ;; \
      *) echo "no Orca AppImage for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/stablyai/orca/releases/download/v${ORCA_VERSION}/${appimage}" \
      -o /tmp/orca.AppImage; \
    chmod +x /tmp/orca.AppImage; \
    cd /opt && /tmp/orca.AppImage --appimage-extract >/dev/null; \
    mv squashfs-root orca; \
    rm /tmp/orca.AppImage; \
    npm install -g @anthropic-ai/claude-code @openai/codex; \
    npm cache clean --force; \
    rm -rf /var/lib/apt/lists/*

# ELECTRON_RUN_AS_NODE runs the CLI entry as plain node. `serve` re-spawns the
# binary as a real Electron app and strips the variable itself, so setting it
# here does not follow the server into its own process.
#
# PAIRING_ADDRESS is a runtime value; see pairing-address.sh for why.
RUN set -eux; \
    printf '%s\n' \
      '#!/bin/sh' \
      'CLI=/opt/orca/resources/app.asar.unpacked/out/cli/index.js' \
      'if [ "$1" = serve ] && [ -n "${PAIRING_ADDRESS:-}" ]; then' \
      '  shift' \
      '  set -- serve --pairing-address "$PAIRING_ADDRESS" "$@"' \
      'fi' \
      'exec env ELECTRON_RUN_AS_NODE=1 /opt/orca/orca-ide "$CLI" "$@"' \
      > /usr/local/bin/orca; \
    chmod +x /usr/local/bin/orca

ENTRYPOINT ["orca"]
