# The official OpenCode image is Alpine (musl), and OpenCode's terminal loads a
# glibc-only native PTY library, so the integrated terminal is broken there.
# node:24-slim is Debian/glibc, and node/npm are useful to the agent anyway.
FROM docker.io/library/node:24-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git openssh-client ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g opencode-ai \
 && npm cache clean --force

ENTRYPOINT ["opencode"]
