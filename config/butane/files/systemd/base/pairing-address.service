[Unit]
Description=Record the box's LAN address for Orca pairing offers
# No ordering against orca.container is possible — that is a user unit. If it
# wins the race podman fails on the missing --env-file and its Restart=always
# retries. Same contract as /mnt/state/secrets/orca.env.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pairing-address.sh

[Install]
WantedBy=multi-user.target
