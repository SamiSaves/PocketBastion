[Unit]
Description=Generate WireGuard server keys and render wg0.conf
# After=firewall.service so UDP 51820 is open before the tunnel starts. Declared
# here, not in firewall.service, so pocketbastion.bu never references a unit that
# lan mode does not have.
After=var-mnt-state.mount state-dirs.service firewall.service network.target
Requires=var-mnt-state.mount state-dirs.service
Before=wg-quick@wg0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/wg-setup.sh

[Install]
WantedBy=multi-user.target
