variant: fcos
version: 1.5.0
# base.bu — shared Butane baseline for every environment.
#
# This file is NOT rendered on its own. render-ignition.sh deep-merges it with a
# platform overlay and any optional feature layers, using `yq ... *+`, before
# piping the result to Butane:
#
#   base.bu *+ <platform>.bu *+ [features/<feature>.bu ...]
#
# Invariant: every file path and every systemd unit name lives in exactly ONE
# layer. `*+` appends arrays, so a path/name defined twice would produce a
# duplicate and Butane --strict would reject it. Keep divergent entries
# (hostname, root disk device, format-on-first-boot) in the platform overlay,
# and anything optional in a feature layer.
passwd:
  users:
    # The core user (UID 1000) owns the rootless Quadlet containers; SSH key
    # injected at render time.
    #
    # password_hash is a PUBLIC default for break-glass console login only
    # (serial / DO web console). Not a network credential: sshd is key-only +
    # WG-only. Change it on first console login (see README).
    - name: core
      password_hash: "$6$uxZJIlbecCN0.R4V$uEOl0OUAciUTCoeuzZLooVYni9Mr9jHTfZRHDs8QaieEWp0o0kZJ7eviUFHeutibqDA/jAb/E/1DGDTtVuIQ51"
      ssh_authorized_keys:
        - "${SSH_AUTHORIZED_KEY}"
      groups:
        - wheel
        - sudo
storage:
  directories:
    # /mnt is a symlink to /var/mnt on CoreOS; use the canonical path.
    - path: /var/mnt/state
      mode: 0755
  files:
    - path: /etc/ssh/sshd_config.d/99-hardening.conf
      mode: 0600
      contents:
        inline: |
          PasswordAuthentication no
          PermitRootLogin no
          AuthenticationMethods publickey
    # Equivalent to `loginctl enable-linger core`: starts the core user's
    # systemd instance (and its rootless containers) at boot, no login needed.
    - path: /var/lib/systemd/linger/core
      mode: 0644
      contents:
        inline: ""
    - path: /etc/containers/systemd/users/1000/opencode.container
      mode: 0644
      contents:
        local: files/etc/containers/systemd/users/1000/opencode.container
    # Butane reads `contents.local` files verbatim, so they never pass through
    # envsubst. Anything rendered has to be an `inline` dropin like these two.
    - path: /etc/containers/systemd/users/1000/opencode.container.d/10-render.conf
      mode: 0644
      contents:
        inline: |
          [Container]${OPENCODE_PUBLISH}${OPENCODE_MEMORY_ARGS}
    - path: /etc/containers/systemd/users/1000/opencode.container.d/20-lan-guard.conf
      mode: 0644
      contents:
        inline: |
          [Service]${OPENCODE_LAN_GUARD}
    # Read at boot by firewall-setup.sh, and by hardening-check.sh over SSH, so
    # both see the mode the box was actually rendered with.
    - path: /etc/opencode/firewall.env
      mode: 0644
      contents:
        inline: |
          NETWORK_MODE=${NETWORK_MODE}
          TRUSTED_CIDRS="${TRUSTED_CIDRS}"
          OPENCODE_PORTS="${OPENCODE_PORTS}"
    - path: /etc/systemd/zram-generator.conf
      mode: 0644
      contents:
        inline: |
          ${ZRAM_CONFIG}
    - path: /usr/local/sbin/swapfile-setup.sh
      mode: 0750
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail
          SIZE="${SWAPFILE_SIZE}"
          [[ -n "$SIZE" ]] || exit 0
          [[ -e /var/swapfile ]] && exit 0
          bytes=$(numfmt --from=iec "$SIZE")
          dd if=/dev/zero of=/var/swapfile bs=1M count=$((bytes / 1048576)) status=none
          chmod 600 /var/swapfile
          mkswap /var/swapfile
          swapon /var/swapfile
    # Quadlet .build unit + its Containerfile: builds a Debian/glibc OpenCode
    # image on the box (the official image is Alpine/musl, which breaks the
    # terminal). opencode.container references this via Image=opencode.build.
    - path: /etc/containers/systemd/users/1000/opencode.build
      mode: 0644
      contents:
        local: files/etc/containers/systemd/users/1000/opencode.build
    - path: /etc/opencode/Containerfile
      mode: 0644
      contents:
        local: files/etc/opencode/Containerfile
    - path: /usr/local/sbin/firewall-setup.sh
      mode: 0750
      contents:
        local: files/usr/local/sbin/firewall-setup.sh
    # Wired in as an ExecStartPre only in lan mode, via the 20-lan-guard dropin.
    - path: /usr/local/sbin/opencode-password-check.sh
      mode: 0755
      contents:
        local: files/usr/local/sbin/opencode-password-check.sh
    # Regenerates git/ssh config from the deploy keys on the state disk (run at
    # boot and by repo-add/repo-remove). Source of truth is the keys, not this.
    - path: /usr/local/sbin/git-setup.sh
      mode: 0750
      contents:
        local: files/usr/local/sbin/git-setup.sh
    # Commit identity for git inside the container, baked from deploy.env at
    # render time. git-setup.sh installs it as the container's ~/.gitconfig.
    # core.sshCommand forces our ssh config: ssh looks in the passwd home (/root),
    # not $HOME (/data), so /data/.ssh/config would otherwise be ignored.
    - path: /etc/opencode/gitconfig
      mode: 0644
      contents:
        inline: |
          [user]
          name = ${GIT_USER_NAME}
          email = ${GIT_USER_EMAIL}
          [core]
          sshCommand = ssh -F /data/.ssh/config
systemd:
  units:
    - name: state-dirs.service
      enabled: true
      contents_local: files/systemd/base/state-dirs.service
    - name: git-setup.service
      enabled: true
      contents_local: files/systemd/base/git-setup.service
    # Ordered after the state mount, to read the persistent toggle override.
    # It must NOT be ordered against any WireGuard unit: those live in the
    # optional feature layer and need not exist.
    - name: firewall.service
      enabled: true
      contents_local: files/systemd/base/firewall.service
    - name: swapfile.service
      enabled: true
      contents_local: files/systemd/base/swapfile.service
