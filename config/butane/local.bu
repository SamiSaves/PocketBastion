variant: fcos
version: 1.5.0
# local.bu — LOCAL overlay (KVM/libvirt dev VM). Merged onto base.bu; see base.bu.
#
# Contains ONLY what differs from base for local development:
#   - local hostname + motd
#   - the hello.container smoke test (local validation only)
#   - state disk on /dev/vdb (libvirt's second disk)
# Core user, SSH key, firewall, bootstrap WG peer all live in base.bu.
storage:
  filesystems:
    # Same idiom as rpi.bu: Ignition creates the filesystem only if the device
    # has none (wipe_filesystem: false), and Butane generates the mount unit
    # from with_mount_unit. create-vm.sh always attaches this disk at creation,
    # so it exists by the time Ignition runs in the initramfs.
    - device: /dev/vdb
      format: ext4
      label: state
      wipe_filesystem: false
      mount_options:
        - noatime
      with_mount_unit: true
      path: /var/mnt/state
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: pocketbastion-local
    - path: /etc/motd
      mode: 0644
      overwrite: true
      contents:
        inline: |
          ┌─────────────────────────────────────────────┐
          │  PocketBastion  (local KVM)                 │
          │  /mnt/state is the only persistent data     │
          └─────────────────────────────────────────────┘

    # Rootless smoke-test container (picked up by the core user's systemd, not root).
    - path: /etc/containers/systemd/users/1000/hello.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Hello Quadlet smoke test
          After=network-online.target
          Wants=network-online.target

          [Container]
          Image=docker.io/library/nginx:alpine
          ContainerName=hello
          PublishPort=127.0.0.1:8080:80

          [Service]
          Restart=on-failure
          RestartSec=5

          [Install]
          WantedBy=default.target
